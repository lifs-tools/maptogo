FROM python:3.12-slim-trixie AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
# Include dev dependencies
ENV UV_NO_DEV=0
# Do not install a new Python version, use the system / base image one
ENV UV_PYTHON_DOWNLOADS=0
# Install other dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libxml2-dev \
    libxslt1-dev \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man \
    && apt-get clean

# Install uv
ADD https://astral.sh/uv/0.9.20/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"

RUN mkdir /wd
WORKDIR /wd
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project

COPY . /wd
COPY uv.lock /wd
WORKDIR /wd/src
RUN make
WORKDIR /wd
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

COPY maptogo.ini* /wd/

FROM python:3.12-slim-trixie

RUN useradd -ms /bin/sh -u 1001 app

COPY --from=builder --chown=app:app /wd /wd

ENV PATH="/wd/.venv/bin:$PATH"

USER app
WORKDIR /wd
EXPOSE 8040

# Run Dash's built-in dev server with hot reload (debug=True is set in app.py)
CMD ["python", "app.py"]
